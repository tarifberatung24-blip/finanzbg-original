NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# n8n production webhook for manual offer requests. Use the production URL from
# an active n8n Webhook node. Header auth can compare X-FinanzBG-Webhook-Secret.
N8N_OFFER_REQUEST_WEBHOOK_URL=https://your-n8n.example/webhook/finanzbg-offer-request
N8N_WEBHOOK_SECRET=change-me

# Exact deeplinks supplied by each approved affiliate program. Never use a
# normal consumer URL here: it may not track commission attribution.
AFFILIATE_SCHUFA_URL=https://example.com/your-awin-schufa-deeplink
AFFILIATE_CREDIT_URL=https://example.com/your-check24-credit-deeplink
AFFILIATE_KFZ_URL=https://example.com/your-kfz-affiliate-deeplink
AFFILIATE_ENERGY_URL=https://example.com/your-strom-gas-affiliate-deeplink
GROQ_API_KEY=
# Public legal information shown in the imprint. Do not use a tax number here.
LEGAL_BUSINESS_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER_COURT=
LEGAL_REGISTER_NUMBER=
